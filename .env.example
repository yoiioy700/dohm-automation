# DOHM Finance Testnet Automation Config (EXAMPLE)
APP_URL="https://testnet.dohm.finance"
HEADLESS="true"
INTERVAL_HOURS="24"

# Pengaturan Jumlah Transaksi Acak per Akun
MIN_TX_PER_RUN="3"
MAX_TX_PER_RUN="7"

# Jeda Acak Antar Transaksi & Antar Akun (Detik)
MIN_DELAY_SECONDS="5"
MAX_DELAY_SECONDS="15"
ACCOUNT_DELAY_MIN="10"
ACCOUNT_DELAY_MAX="30"

# Rentang Nominal Nominal Acak Tiap Aksi
SWAP_MIN="0.0002"
SWAP_MAX="0.002"
BOND_MIN="0.0005"
BOND_MAX="0.003"
STAKE_MIN="0.05"
STAKE_MAX="0.3"
UNSTAKE_MIN="0.01"
UNSTAKE_MAX="0.05"
